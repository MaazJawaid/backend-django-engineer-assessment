# Free HeiGIT / OpenRouteService API key (optional)
# Sign up at https://account.heigit.org/ if you want your own key.
# If unset, settings fall back to a bundled demo key so reviewers can run
# the app without creating an account. Override here to use your own.
# ORS_API_KEY=your_api_key_here

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Per-stage API timings (JSON timings + Server-Timing header + logs)
INCLUDE_TIMINGS=True
